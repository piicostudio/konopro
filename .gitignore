# standard gitignore files
.DS_Store
.env
.env.*
!.env.example
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/
*.log
*.db
*.sqlite
*.sqlite3

# Node/web frontend local artifacts.
node_modules/
dist/
.vercel/

# Local demo audio assets are intentionally not committed.
web/assets/*.mp3

# Local Python environments created inside the research prototype.
research/.venv/

# Local backend state.
.local/
backend/.local/

# Generated demo artifacts. These can be recreated with:
# cd research && uv run python scripts/generate_demo_data.py
research/data/demo/*.wav
research/data/demo/*.csv
research/data/demo/metadata.json
docs/*

# Private local experiments may use copyrighted or personally recorded audio.
research/data/private/*
!research/data/private/.gitkeep

# Research scratch outputs that are useful locally but not core demo source.
research/reports/
research/notebooks/
research/.cache/

# Local Streamlit state.
.streamlit/

# Local build, planning, and visual brainstorming artifacts.
.build/
.planning/
.superpowers/
documentation/

# Parked native iOS prototype lives outside the current Flutter/web MVP.
/ios/
xcuserdata/
*.xcuserstate
web.zip
