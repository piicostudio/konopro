# standard gitignore files
.DS_Store
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/

# Local Python environments created inside the research prototype.
research/.venv/

# Generated demo artifacts. These can be recreated with:
# cd research && uv run python scripts/generate_demo_data.py
research/data/demo/*.wav
research/data/demo/*.csv
research/data/demo/metadata.json

# Private local experiments may use copyrighted or personally recorded audio.
research/data/private/*
!research/data/private/.gitkeep

# Research scratch outputs that are useful locally but not core demo source.
research/reports/
research/notebooks/
research/.cache/

# Local Streamlit state.
.streamlit/
